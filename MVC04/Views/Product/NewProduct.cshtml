@model MVC04.Models.Product

@{
    ViewData["Title"] = "Thêm mới mặt hàng";
}

@section Styles {
    <link rel="stylesheet" href="~/css/product.css" asp-append-version="true" />
}

<div class="product-wrapper">
    <div class="product-card">
        <div class="product-card-header">
            <h2 class="product-card-title">Thêm Mới Mặt Hàng (Product)</h2>
        </div>
        <div class="product-card-body">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert-box alert-success" id="successAlert">
                    <span>✓ <strong>Thành công!</strong> @TempData["SuccessMessage"]</span>
                    <button type="button" class="alert-close-btn" onclick="document.getElementById('successAlert').style.display='none'">&times;</button>
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="alert-box alert-error"></div>

            <form asp-action="NewProduct" method="post" id="formNewProduct" novalidate>
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label asp-for="ProductName" class="form-label">
                        Tên mặt hàng <span class="required-mark">*</span>
                    </label>
                    <input asp-for="ProductName" class="form-control-custom" placeholder="Ví dụ: Bàn phím cơ DareU EK87..." required maxlength="200" autocomplete="off" />
                    <span asp-validation-for="ProductName" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ImageURL" class="form-label">
                        URL ảnh đại diện (.png) <span class="required-mark">*</span>
                    </label>
                    <input asp-for="ImageURL" id="imageInput" class="form-control-custom" placeholder="Ví dụ: /images/product.png hoặc link kết thúc bằng .png" required pattern="(?i)^.+\.png$" maxlength="500" />
                    <span asp-validation-for="ImageURL" class="field-validation-error"></span>

                    <div id="imagePreviewContainer" class="image-preview-box" style="display: none;">
                        <div class="preview-title">Xem trước ảnh đại diện:</div>
                        <img id="imagePreview" src="" alt="Xem trước ảnh" class="preview-image" />
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="ProductPrice" class="form-label">
                        Đơn giá (VNĐ) <span class="required-mark">*</span>
                    </label>
                    <div class="price-input-group">
                        <input asp-for="ProductPrice" class="form-control-custom" type="number" step="0.01" min="0" placeholder="0.00" required />
                        <span class="price-suffix">₫</span>
                    </div>
                    <span asp-validation-for="ProductPrice" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Description" class="form-label">
                        Mô tả mặt hàng
                    </label>
                    <textarea asp-for="Description" class="form-control-custom" rows="4" placeholder="Nhập thông tin mô tả chi tiết của sản phẩm..."></textarea>
                    <span asp-validation-for="Description" class="field-validation-error"></span>
                </div>

                <div class="form-actions">
                    <button type="reset" class="btn-custom btn-secondary-custom" id="btnReset">
                        Nhập lại
                    </button>
                    <button type="submit" class="btn-custom btn-primary-custom">
                        Lưu sản phẩm
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            const $imageInput = $('#imageInput');
            const $previewContainer = $('#imagePreviewContainer');
            const $imagePreview = $('#imagePreview');

            function updatePreview() {
                const val = $imageInput.val().trim();
                if (val && val.toLowerCase().endsWith('.png')) {
                    $imagePreview.attr('src', val);
                    $previewContainer.show();
                } else {
                    $previewContainer.hide();
                    $imagePreview.attr('src', '');
                }
            }

            $imageInput.on('input change', updatePreview);
            updatePreview();

            $('#btnReset').on('click', function () {
                setTimeout(function () {
                    $previewContainer.hide();
                    $('.field-validation-error').empty();
                    $('.input-validation-error').removeClass('input-validation-error');
                }, 50);
            });
        });
    </script>
}
