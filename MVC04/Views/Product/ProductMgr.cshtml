@model IEnumerable<MVC04.Models.Product>

@{
    ViewData["Title"] = "Quản lý hàng hóa";
    int stt = 1;
}

@section Styles {
    <link rel="stylesheet" href="~/css/product.css" asp-append-version="true" />
}

<div class="product-mgr-wrapper">
    @* Thong bao sau khi thuc hien hanh dong *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-box alert-success" id="mgrSuccessAlert">
            <span>✓ <strong>Thành công!</strong> @TempData["SuccessMessage"]</span>
            <button type="button" class="alert-close-btn" onclick="document.getElementById('mgrSuccessAlert').style.display='none'">&times;</button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-box alert-error" id="mgrErrorAlert">
            <span>✕ <strong>Lỗi!</strong> @TempData["ErrorMessage"]</span>
            <button type="button" class="alert-close-btn" onclick="document.getElementById('mgrErrorAlert').style.display='none'">&times;</button>
        </div>
    }

    <div class="table-header-actions">
        <h2 class="page-title">Quản lý hàng hóa</h2>
        <a asp-action="NewProduct" class="btn-add-new">
            <span>+</span> Thêm mới sản phẩm
        </a>
    </div>

    <div class="table-responsive">
        <table class="custom-table" id="productTable">
            <thead>
                <tr>
                    <th class="text-center" style="width: 70px;">STT</th>
                    <th>Tên hàng</th>
                    <th style="width: 160px;">Đơn giá</th>
                    <th>Mô tả</th>
                    <th class="text-center" style="width: 110px;">Xử lý</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr id="row-@item.ProductID" class="product-row">
                            <td class="text-center fw-bold col-stt">@(stt++)</td>
                            <td class="fw-semibold">@item.ProductName</td>
                            <td>@string.Format("{0:N0} VND", item.ProductPrice)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                            <td class="text-center">
                                <a href="javascript:void(0);"
                                   class="btn-delete-link"
                                   onclick="deleteProductAjax(@item.ProductID, this);">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        <line x1="10" y1="11" x2="10" y2="17"></line>
                                        <line x1="14" y1="11" x2="14" y2="17"></line>
                                    </svg>
                                    Xóa
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="emptyRow">
                        <td colspan="5" class="empty-state">
                            Chưa có mặt hàng nào trong CSDL. <a asp-action="NewProduct" style="color: var(--primary-color);">Bấm vào đây để thêm mới!</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Toast thong bao ket qua AJAX *@
<div id="ajaxToast" class="ajax-toast"></div>

@section Scripts {
    <script>
       
        function deleteProductAjax(productId, btnElement) {
            var confirmed = confirm("Có chắc chắn xóa không?");
            if (!confirmed) {
                return;
            }
            var xhr = new XMLHttpRequest();
            var url = "/Product/DeleteAjax/" + productId;

            xhr.open("POST", url, true);
            xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");

            xhr.onreadystatechange = function () {
                if (xhr.readyState === XMLHttpRequest.DONE) {
                    if (xhr.status === 200) {
                        try {
                            var response = JSON.parse(xhr.responseText);
                            if (response.success) {
                                var targetRow = btnElement.closest("tr");
                                if (targetRow) {
                                    targetRow.classList.add("row-fade-out");
                                    setTimeout(function () {
                                        targetRow.remove();
                                        updateSttNumbers();
                                    }, 450);
                                }

                                showToast(response.message || "Xóa mặt hàng thành công!", "success");
                            } else {
                                showToast(response.message || "Xóa mặt hàng thất bại!", "error");
                            }
                        } catch (e) {
                            showToast("Lỗi khi đọc dữ liệu phản hồi từ máy chủ!", "error");
                        }
                    } else {
                        showToast("Lỗi kết nối máy chủ (Mã: " + xhr.status + "). Vui lòng thử lại!", "error");
                    }
                }
            };

            xhr.send();
        }

       
        function updateSttNumbers() {
            var rows = document.querySelectorAll("#productTable tbody tr.product-row");
            var tbody = document.querySelector("#productTable tbody");

            if (rows.length === 0) {
                tbody.innerHTML = '<tr id="emptyRow"><td colspan="5" class="empty-state">Chưa có mặt hàng nào trong CSDL. <a href="/Product/NewProduct" style="color: var(--primary-color);">Bấm vào đây để thêm mới!</a></td></tr>';
            } else {
                rows.forEach(function (row, index) {
                    var sttCell = row.querySelector(".col-stt");
                    if (sttCell) {
                        sttCell.textContent = index + 1;
                    }
                });
            }
        }

        var toastTimer = null;
        function showToast(message, type) {
            var toast = document.getElementById("ajaxToast");
            if (!toast) return;

            toast.textContent = (type === "success" ? "Done" " : "Err") + message;
            toast.className = "ajax-toast " + (type === "success" ? "toast-success" : "toast-error") + " show";

            if (toastTimer) {
                clearTimeout(toastTimer);
            }

            toastTimer = setTimeout(function () {
                toast.classList.remove("show");
            }, 3000);
        }
    </script>
}
